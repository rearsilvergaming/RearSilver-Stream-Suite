<RCC>
  <qresource prefix="/rs/music">
    <file alias="music-fallback-vinyl.png">assets/music/music-fallback-vinyl.png</file>
    <file alias="overlay/music-overlay.html">assets/overlay/music-overlay.html</file>
  </qresource>
  <qresource prefix="/rs/branding">
    <file alias="app-icon.png">assets/branding/app-icon.png</file>
    <file alias="header-wide.png">assets/branding/header-wide.png</file>
    <file alias="splash.png">assets/branding/splash.png</file>
    <file alias="Sora-Variable.ttf">assets/fonts/Sora-Variable.ttf</file>
  </qresource>
  <qresource prefix="/rs/stream-overlays">
    <file alias="quick-text.html">assets/overlay/quick-text-overlay.html</file>
  </qresource>
</RCC>
